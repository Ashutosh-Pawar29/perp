# syntax=docker/dockerfile:1
FROM oven/bun:1.3-alpine AS base
WORKDIR /app

# Install OpenSSL & libc requirements for Prisma engine
RUN apk add --no-cache openssl libc6-compat

# Step 1: Copy root workspace configs and locks
COPY package.json bun.lock turbo.json ./

# Step 2: Copy shared packages and application code
COPY packages/ ./packages/
COPY apps/backend/ ./apps/backend/
COPY apps/ws/ ./apps/ws/

# Step 3: Install all dependencies across the monorepo
RUN bun install 

# Step 4: Generate Prisma Client inside packages/db
WORKDIR /app/packages/db
ENV DATABASE_URL="postgresql://postgres:postgres@localhost:5432/perps_v2?schema=public"
RUN bunx prisma generate

WORKDIR /app

# Default port for API/WS gateway
EXPOSE 3000

# Default command (can be overridden in K8s pod spec)
CMD ["bun", "run", "apps/ws/index.ts"]
